// 薪火数据模型 —— 术语以根目录 GLOSSARY.md 为准
// T2 新增 user（认证竖切）；T3 新增技艺条目展示竖切（CraftItem 完整展示字段 / Inheritor / Tag / BehaviorEvent）；
// T5 新增课程与学习进度竖切（Course / Step / LearningRecord）；
// T6 新增交流区竖切（Post / Comment）。

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

// Prisma 7：连接 URL 不再写在 schema 里，CLI 走 prisma.config.ts，客户端走 driver adapter
datasource db {
  provider = "postgresql"
}

/// 平台角色：学习者 / 传承人 / 管理员（传承人由管理员线下核实后标记，无线上自助认证）
enum Role {
  LEARNER
  INHERITOR
  ADMIN
}

/// 技艺条目发布状态：仅 PUBLISHED 对游客可见
enum CraftItemStatus {
  DRAFT
  PUBLISHED
}

/// 交流区内容状态（帖子/评论共用）：管理员下架即 HIDDEN，恢复回 VISIBLE
enum ContentStatus {
  VISIBLE
  HIDDEN
}

/// 学习行为事件类型（规格 #1 用户故事 27 的五类，仅登录用户记录）
enum BehaviorEventType {
  /// 浏览技艺条目详情
  VIEW_ITEM
  /// 开始课程
  START_COURSE
  /// 完成步骤
  COMPLETE_STEP
  /// 发帖
  CREATE_POST
  /// 评论
  CREATE_COMMENT
}

/// 账号 —— 学习者、传承人与管理员的登录主体（自实现认证：argon2 哈希 + Redis 会话）
model User {
  id          Int      @id @default(autoincrement())
  /// 登录用户名，全局唯一（3~30 字符）
  username    String   @unique
  /// 对外展示的昵称
  displayName String   @map("display_name")
  /// argon2 哈希，永不出库（见规格 #1 Implementation Decisions）
  passwordHash String  @map("password_hash")
  role        Role     @default(LEARNER)
  createdAt   DateTime @default(now()) @map("created_at")

  behaviorEvents BehaviorEvent[]
  /// 传承人账号发布的课程（作者）
  courses Course[]
  /// 学习进度记录（已完成步骤）
  learningRecords LearningRecord[]
  posts Post[]
  comments Comment[]

  @@map("user")
}

/// 技艺条目 —— 平台内容的基本单元，对应传统技艺类非遗代表性名录中的一项
model CraftItem {
  id String @id @default(cuid())
  name String @unique
  /// 子类别（陶瓷、织绣、漆器、造纸印刷、金属加工、酿造等）
  subcategory String @map("subcategory")
  /// 列入国家级名录的批次（如“第一批（2006 年）”）
  batch String @map("batch")
  /// 国家级名录编号（如“Ⅷ-1”）
  code String @map("code")
  /// 申报地区
  region String @map("region")
  /// 历史渊源
  history String @map("history")
  /// 工艺特色
  features String @map("features")
  /// 图集：{url, credit} 数组，credit 标注图片出处与许可
  images Json @default("[]")
  /// 视频外链（B 站），可空
  videoUrl String? @map("video_url")
  status CraftItemStatus @default(PUBLISHED)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  inheritors Inheritor[]
  tags CraftItemTag[]
  /// 挂在本条目下的课程
  courses Course[]

  @@index([status, subcategory])
  @@map("craft_item")
}

/// 传承人 —— 非遗代表性传承人，作为平台展示的人物实体挂在技艺条目下
model Inheritor {
  id String @id @default(cuid())
  name String @map("name")
  /// 人物简介
  bio String @map("bio")
  /// 代表性传承人级别（国家级/省级等）
  level String @map("level")
  craftItemId String @map("craft_item_id")

  craftItem CraftItem @relation(fields: [craftItemId], references: [id], onDelete: Cascade)

  /// 同一条目下传承人姓名唯一，支撑种子幂等 upsert
  @@unique([craftItemId, name])
  @@map("inheritor")
}

/// 条目标签 —— 推荐算法的数据源
model Tag {
  id String @id @default(cuid())
  name String @unique

  items CraftItemTag[]

  @@map("tag")
}

/// 技艺条目 ↔ 标签 多对多
model CraftItemTag {
  craftItemId String @map("craft_item_id")
  tagId String @map("tag_id")

  craftItem CraftItem @relation(fields: [craftItemId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([craftItemId, tagId])
  @@map("craft_item_tag")
}

/// 课程发布状态：草稿 → 提交审核 → 管理员发布或驳回（工单 #6）
enum CourseStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

/// 学习行为事件 —— 画像的原始数据（仅登录用户），多态目标：targetType + targetId
model BehaviorEvent {
  id String @id @default(cuid())
  /// 触发者；游客不产生事件，理论非空，保留可空以容错脏数据
  userId Int? @map("user_id")
  type BehaviorEventType @map("type")
  /// 目标类型（如 CRAFT_ITEM / COURSE / POST / COMMENT）
  targetType String @map("target_type")
  /// 目标 ID（多态，不设数据库外键）
  targetId String @map("target_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([type, targetId])
  @@map("behavior_event")
}

/// 课程 —— 某个技艺条目下的结构化图文教程，由传承人（或管理员）账号创建并维护（工单 #6）model Course {
  id String @id @default(cuid())
  /// 课程标题
  title String
  /// 课程简介
  intro String
  /// 挂载的技艺条目
  craftItemId String @map("craft_item_id")
  /// 作者（传承人账号，管理员代建时为其本人）
  authorId Int @map("author_id")
  status CourseStatus @default(DRAFT)
  /// 驳回理由（管理员驳回时可附，传承人可见；重新提交时清空）
  rejectReason String? @map("reject_reason")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  craftItem CraftItem @relation(fields: [craftItemId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  steps Step[]

  @@index([craftItemId, status])
  @@index([authorId])
  @@map("course")
}

/// 步骤 —— 课程的最小学习单元，对应一道工序或一个知识点（工单 #6）
model Step {
  id String @id @default(cuid())
  courseId String @map("course_id")
  /// 同课程内从 1 递增的排序（唯一约束保证不重不漏）
  order Int
  /// 步骤标题
  title String
  /// 图文内容
  content String
  /// 可选配图地址
  imageUrl String? @map("image_url")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  learningRecords LearningRecord[]

  @@unique([courseId, order])
  @@map("step")
}

/// 学习进度记录 —— 学习者已完成步骤（工单 #6）。
/// userId + stepId 联合主键天然幂等：重复标记完成不会产生重复记录；
/// 学习进度 = 某课程下 learning_record 数 / 该课程总步骤数。
model LearningRecord {
  userId Int @map("user_id")
  stepId String @map("step_id")
  completedAt DateTime @default(now()) @map("completed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@id([userId, stepId])
  @@index([stepId])
  @@map("learning_record")
}

/// 帖子 —— 学习者在交流区发布的主题讨论（术语见 GLOSSARY：帖子）
model Post {
  id String @id @default(cuid())
  authorId Int @map("author_id")
  /// 标题（1~80 字符）
  title String @map("title")
  /// 正文
  content String @map("content")
  /// 管理员下架即 HIDDEN，前台与列表一律不可见
  status ContentStatus @default(VISIBLE)
  createdAt DateTime @default(now()) @map("created_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@index([status, createdAt])
  @@map("post")
}

/// 评论 —— 对帖子的回复；课程不设评论，课程讨论引流到交流区（术语见 GLOSSARY：评论）
model Comment {
  id String @id @default(cuid())
  postId String @map("post_id")
  authorId Int @map("author_id")
  /// 正文
  content String @map("content")
  /// 管理员下架即 HIDDEN，详情页与评论数均不计
  status ContentStatus @default(VISIBLE)
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, status])
  @@index([authorId])
  @@map("comment")
}
