# ============================================================
# 薪火平台环境变量模板 —— 复制为 .env 后按需修改（.env 不入库）
# ============================================================

# ---- 数据库（应用进程使用）----
# 开发环境指向 compose.dev.yaml 映射到宿主机的端口（默认 5433）
DATABASE_URL=postgresql://xinhuo:xinhuo@localhost:5433/xinhuo
# 集成测试专用库（vitest 每次运行前强制重置，见 tests/global-setup.ts）
TEST_DATABASE_URL=postgresql://xinhuo:xinhuo@localhost:5433/xinhuo_test

# ---- Redis（应用进程使用）----
REDIS_URL=redis://localhost:6380

# ---- compose 容器变量（dev 与生产 compose 共用 .env）----
# 宿主机端口映射（默认避开本机常见占用，可按需修改）
POSTGRES_PORT=5433
REDIS_PORT=6380
# 生产 compose 暴露应用的宿主机端口（宿主机 Caddy 反代指向此端口）
APP_PORT=3000
# PostgreSQL 容器初始化（须与上方 DATABASE_URL / compose 内连接串一致）
POSTGRES_USER=xinhuo
POSTGRES_PASSWORD=xinhuo
POSTGRES_DB=xinhuo
