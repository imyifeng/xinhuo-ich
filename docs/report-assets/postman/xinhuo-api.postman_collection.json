        {
          "name": "条目详情",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/craft-items/{{craft_item_id}}", "host": ["{{base_url}}"], "path": ["api", "craft-items", "{{craft_item_id}}"] },
            "description": "条目详情：名称/批次/编号/申报地区/历史渊源/工艺特色/图集（含出处 credit）/传承人列表/标签/相关课程。登录用户浏览会记录 VIEW_ITEM 行为事件（游客不记）。响应头 X-Cache: HIT | MISS 暴露缓存路径（404 同样携带）。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码 200', () => pm.response.to.have.status(200));",
                  "pm.test('携带 X-Cache 响应头', () => pm.expect(pm.response.headers.get('x-cache')).to.be.oneOf(['HIT', 'MISS', 'BYPASS']));",
                  "const body = pm.response.json();",
                  "pm.test('详情含传承人与标签字段', () => {",
                  "  pm.expect(body).to.have.property('inheritors');",
                  "  pm.expect(body).to.have.property('tags');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
